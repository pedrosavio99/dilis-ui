{
  "name": "@dilis/ui",
  "version": "0.1.0",
  "description": "Design System da Dilis. Componentes React em CSS puro, com tokens da marca e suporte a override via className.",
  "type": "module",
  "license": "MIT",
  "author": "Dilis",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/dilis-ui.cjs",
  "module": "./dist/dilis-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dilis-ui.js",
      "require": "./dist/dilis-ui.cjs"
    },
    "./styles.css": "./dist/dilis-ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run check:manifests && tsc --noEmit && vite build && npm run gen:agent",
    "build:demo": "npm run check:manifests && npm run gen:agent && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "gen:agent": "tsx scripts/gen-agent.ts",
    "new:component": "tsx scripts/new-component.ts",
    "check:manifests": "tsx scripts/check-manifests.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "design-system",
    "react",
    "ui",
    "components",
    "dilis"
  ]
}
